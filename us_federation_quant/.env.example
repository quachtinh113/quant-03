# ==============================================================================
# US FEDERATION QUANT — CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env and fill in your actual credentials.
# ==============================================================================

# MetaTrader 5 Credentials
MT5_ACCOUNT=12345678
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Trial17
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SUFFIX=m

# Operational Modes
LIVE_TRADING=true
ACTIVATION_SCHEDULE=50_STATES_IMMEDIATE
REPLACE_PREVIOUS_BOTS=true

# Constitutional Risk Management Safeguards
MAX_DAILY_DRAWDOWN_USD=500.0
MIN_MARGIN_LEVEL_PERCENT=500.0
MAX_DRAWDOWN_LIMIT=0.10
MAX_GROSS_LEVERAGE=20.0
MAX_SINGLE_POD_WEIGHT=0.08
HALF_KELLY_MAX_FRACTION=0.5
MIN_KELLY_FRACTION=0.05
BLACKROCK_PROFIT_SWEEP_RATIO=0.5
SUPREME_COURT_SECRET_SEAL=your_secret_hash_or_seal

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
