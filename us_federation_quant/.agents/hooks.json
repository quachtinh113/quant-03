{
  "auto-approve-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|Bash|edit_file|write_file|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/hooks/auto_approve.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
